# Server port (defaults to 3000)
PORT=3000

# MongoDB Atlas connection string (optional locally; falls back to server/local-store.json when unset)
MONGODB_URI=
MONGODB_DB_NAME=nayana_portfolio

# Optional admin dashboard passcode (if unset, claim your passcode on first visit to /admin)
ADMIN_PASSCODE=

# Optional comma-separated allowed CORS origins when hosting API separately from Netlify
ALLOWED_ORIGINS=

# Optional backend base URL when hosting Express API separately from Netlify
VITE_API_BASE_URL=
